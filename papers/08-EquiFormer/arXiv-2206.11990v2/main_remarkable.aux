\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {An alternative visualization of the depth-wise tensor product. } We follow the visualization of tensor products in \texttt  {e3nn}\nobreakspace  {}\citep  {e3nn} and separate paths into three parts based on the types of output vectors. We note that one vector in the output irreps feature depends only on one vector in each input irreps feature. \relax }}{32}{figure.caption.13}\protected@file@percent }
\newlabel{fig:depthwise_tensor_product_e3nn}{{3}{32}{\textbf {An alternative visualization of the depth-wise tensor product. } We follow the visualization of tensor products in \texttt {e3nn}~\citep {e3nn} and separate paths into three parts based on the types of output vectors. We note that one vector in the output irreps feature depends only on one vector in each input irreps feature. \relax }{figure.caption.13}{}}
